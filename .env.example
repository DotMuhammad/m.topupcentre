# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FREEFIRE_API_URL: Authorized Free Fire player UID lookup REST endpoint.
# Supports {uid}, {userId}, {region}, and {server} placeholders, or appends query params.
FREEFIRE_API_URL=""

# FREEFIRE_API_KEY: Optional API key or Bearer token for your authorized Free Fire lookup provider.
FREEFIRE_API_KEY=""

# FREEFIRE_API_KEY_HEADER: Optional header name for FREEFIRE_API_KEY (defaults to x-api-key).
FREEFIRE_API_KEY_HEADER="x-api-key"

# FREEFIRE_API_HOST: Optional host header (e.g. for RapidAPI providers).
FREEFIRE_API_HOST=""

# FREEFIRE_API_METHOD: HTTP method expected by provider ("GET" or "POST"). Defaults to GET.
FREEFIRE_API_METHOD="GET"

# FREEFIRE_UID_PARAM: Query/body parameter name for UID (defaults to "uid").
FREEFIRE_UID_PARAM="uid"

# FREEFIRE_REGION_PARAM: Query/body parameter name for region (defaults to "region").
FREEFIRE_REGION_PARAM="region"

# FREEFIRE_REGION_CASE: Optional "lower" or "upper" casing for mapped region codes.
FREEFIRE_REGION_CASE="upper"

# FREEFIRE_REGION_MAP: Optional JSON map from website regions to provider region codes.
# Example: '{"PK":"pk","SG":"sg","GLOBAL":"sg"}'
FREEFIRE_REGION_MAP=""
